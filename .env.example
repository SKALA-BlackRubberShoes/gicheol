# 모듈은 .env를 자동으로 읽지 않습니다. 실행 프로세스의 환경변수에 설정하세요.
OPENAI_API_KEY=
# StartAgent는 호출자가 만든 채팅 모델 객체를 받습니다.
START_AGENT_MODEL=
# 시장 모델의 기본값입니다. 필요한 경우 변경하세요.
OPENAI_WEB_SEARCH_MODEL=gpt-5-mini
OPENAI_MARKET_MODEL=gpt-5-mini
# 웹 검색은 기본 2개 검색어씩 나누며, 묶음당 90초 후 PDF-only 평가로 복구합니다.
OPENAI_WEB_SEARCH_BATCH_SIZE=2
OPENAI_WEB_SEARCH_TIMEOUT_SECONDS=90
# 묶음 단위 복구와 중복되지 않도록 SDK 자동 재시도는 기본 0회입니다.
OPENAI_WEB_SEARCH_MAX_RETRIES=0
