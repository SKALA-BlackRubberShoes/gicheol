# 전체 그래프(main.py)는 저장소 루트의 .env를 자동으로 읽습니다.
# 개별 스크립트는 지원하는 경우 --env-file을, 그 외에는 실행 환경변수를 사용하세요.
OPENAI_API_KEY=
# 선택 사항: 회사 선택 모델만 따로 지정합니다. 비우면 --model을 사용합니다.
# 로컬 Ollama 예: ollama:blackrubbershoes-start:4b (README의 모델 생성 단계 필요)
START_AGENT_MODEL=
# 시장 모델의 기본값입니다. 필요한 경우 변경하세요.
OPENAI_WEB_SEARCH_MODEL=gpt-5-mini
OPENAI_MARKET_MODEL=gpt-5-mini
# 웹 검색은 기본 2개 검색어씩 나누며, 묶음당 90초 후 PDF-only 평가로 복구합니다.
OPENAI_WEB_SEARCH_BATCH_SIZE=2
OPENAI_WEB_SEARCH_TIMEOUT_SECONDS=90
# 묶음 단위 복구와 중복되지 않도록 SDK 자동 재시도는 기본 0회입니다.
OPENAI_WEB_SEARCH_MAX_RETRIES=0

# V2 중립 평가 전용. 기존 CLI 설정과 별도이며 모델 ID는 직접 지정합니다.
SUPERVISOR_MODEL=
RESEARCH_MODEL=
REPORT_MODEL=
JUDGE_MODEL=
SEARCH_PROVIDER=
TAVILY_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=neutral_v2_juhyeon_r1
QDRANT_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# main/latest 대신 실제 다운로드한 모델의 40자리 commit SHA
EMBEDDING_REVISION=
EMBEDDING_DIMENSION=1024
REPORT_FONT_PATH=
NEUTRAL_ARTIFACT_ROOT=outputs/juhyeon
NEUTRAL_SQLITE_PATH=outputs/juhyeon/checkpoints.sqlite
NEUTRAL_SERVICES_FACTORY=main.runtime.neutral.services:unconfigured_services
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=neutral-evaluation-v2
